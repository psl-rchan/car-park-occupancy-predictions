{
  "ConnectionStrings": {
    "CarParkDb": ""
  },
  "CarParkData": {
    "Source": "Http",
    "UseSampleSnapshots": false,
    "Schema": "dbo",
    "TableName": "CarParkOccupancySnapshot",
    "SnapshotTimeIsUtc": true,
    "HistoryLookbackDays": 400,
    "CommandTimeoutSeconds": 60,
    "HighOccupancyThresholdPercent": 80,
    "Columns": {
      "CarParkCode": "CarParkCode",
      "SnapshotTime": "SnapshotTime",
      "CountingCategory": "CountingCategory",
      "Capacity": "Capacity",
      "Occupied": "Occupied"
    },
    "Http": {
      "BaseUrl": "http://localhost:5095",
      "CarParksPath": "api/carparks",
      "HistoryPathTemplate": "api/carparks/{code}/occupancy",
      "LatestPathTemplate": "api/carparks/{code}/occupancy/latest",
      "LatestAllPath": "api/occupancy/latest",
      "TimeoutSeconds": 30,
      "PageSize": 1000,
      "SampleEverySeconds": 300,
      "MaxPages": 50,
      "AuthHeaderName": "",
      "AuthHeaderValue": "",
      "Json": {
        "CarParkCode": "carParkCode",
        "SnapshotTime": "snapshotTime",
        "CountingCategory": "countingCategory",
        "Capacity": "capacity",
        "Occupied": "occupied",
        "Collection": "items"
      }
    }
  },
  "Prediction": {
    "DefaultPredictor": "HistoricalBaseline",
    "Timezone": "Asia/Hong_Kong",
    "RecentTrendHours": 6,
    "TrendDecay": 0.7,
    "Vertex": {
      "ProjectId": "",
      "Location": "",
      "Model": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
